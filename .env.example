# =============================================================================
# .env.example — cocoro-llm-server
# このファイルを .env にコピーして実際の値を設定してください。
# 通常は scripts/first_setup.sh が対話式で .env を自動生成します。
#
#   cp .env.example .env
#   vim .env
#
# 【重要】.env は「秘密の値」だけを置く場所です。
# モデル選定・VRAM配分・並列数などのチューニングは docker-compose.yml に
# 直書きされており（git管理で一元化）、.env では設定しません。
# サーバーでは初回に1度だけ設定し、以後は触りません。
# =============================================================================

# ──────────────────────────────────────────────────────────────
# HuggingFace（モデルダウンロード用・秘密）
# モデルが既にローカルにある場合は空のままでOK
# 取得: https://huggingface.co/settings/tokens
# ──────────────────────────────────────────────────────────────
HF_TOKEN=

# ──────────────────────────────────────────────────────────────
# LiteLLM ゲートウェイ（秘密）
# クライアントが接続する API キー。必ず変更してください。
# scripts/first_setup.sh を使うと自動生成されます。
# ──────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=

# ──────────────────────────────────────────────────────────────
# Anthropic（Claude フォールバック用・任意・秘密）
# 設定すると smart-coder ルートでローカルが失敗した時に Claude へ自動切替
# 取得: https://console.anthropic.com/settings/keys
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────
# （任意）モデルキャッシュの場所。未設定なら /hf_cache を使用。
# 通常は変更不要。高速SSD/NVMe推奨（モデル ~35GB）。
# ──────────────────────────────────────────────────────────────
# HF_CACHE_DIR=/hf_cache

# ──────────────────────────────────────────────────────────────
# （任意・デバッグ用）anthropic-proxy(:4001) の変換前後をファイルへ落とす。
# 空＝オフ。会話全文がディスクに残るので、切り分けの時だけ有効にして戻す。
# 有効化: PROXY_DUMP_DIR=/dumps を設定 → docker compose up -d anthropic-proxy
# 出力先はホストの PROXY_DUMP_HOST_DIR（既定 /var/tmp/proxy-dumps）。
# ──────────────────────────────────────────────────────────────
# PROXY_DUMP_DIR=/dumps
# PROXY_DUMP_HOST_DIR=/var/tmp/proxy-dumps

# ──────────────────────────────────────────────────────────────
# （任意）:4001 経由の思考モード。既定 false＝オフ。
# オンにすると Qwen3 系は出力トークンの大半を英語の思考文に使い、
# 本文が空のまま返ることがある（実測: max_tokens=32000 が全部思考）。
# ──────────────────────────────────────────────────────────────
# PROXY_ENABLE_THINKING=false
