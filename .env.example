# =============================================================================
# cocoro-llm-server — 環境変数テンプレート
# コピーして使用: cp .env.example .env
# .env はgitにコミットしないこと（.gitignoreで除外済み）
#
# 構成: Qwen 2.5 72B Instruct AWQ 単体構成
# GPU : RTX PRO 6000 Blackwell / VRAM 94.96 GiB GDDR7
# vLLM: 0.19.0 (~/.venv/cocoro-llm)
# =============================================================================

# ── モデルパス ────────────────────────────────────────────────────────────────
# Qwen 2.5 72B Instruct AWQ 単体構成 (HuggingFace形式)
# ダウンロード:
#   source ~/.venv/cocoro-llm/bin/activate
#   huggingface-cli download Qwen/Qwen2.5-72B-Instruct-AWQ \
#     --local-dir /models/qwen25-72b --resume-download
PRIMARY_MODEL_PATH=/models/qwen25-72b

# ── vLLM 仮想環境パス ─────────────────────────────────────────────────────────
# vLLM 0.19.0 インストール済み仮想環境
VLLM_VENV_DIR=/home/mdl/.venv/cocoro-llm

# ── vLLM設定 ──────────────────────────────────────────────────────────────────
# 単体構成: Primary (Qwen 2.5 72B AWQ) のみ使用
PRIMARY_HOST=0.0.0.0
PRIMARY_PORT=8080

# トークナイザーパス (AWQモデルはトークナイザー内蔵 → ローカルパスを指定)
PRIMARY_TOKENIZER_PATH=/models/qwen25-72b

# VRAM配分（94.96GB GDDR7 全体の90% ≈ 85.5GB確保）
# Weights: ~38GB (AWQ Q4) + KV cache: ~47GB
PRIMARY_GPU_UTIL=0.90

# コンテキスト長 (32K: AWQ量子化済みで十分 / 必要に応じ65536まで拡張可)
PRIMARY_MAX_MODEL_LEN=32768

# 同時リクエスト上限（大VRAM・単体構成で64並列まで対応）
PRIMARY_MAX_NUM_SEQS=64

# HuggingFace Token（モデルダウンロード用）
# https://huggingface.co/settings/tokens でトークン取得
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LiteLLM ──────────────────────────────────────────────────────────────────
# チーム共有キー（全メンバー・cocoro-coreが使用）
# エイリアス: gpt-4o / gpt-4o-mini / qwen25-72b → すべて同モデル
LITELLM_MASTER_KEY=mdl-llm-2026
LITELLM_PORT=8000

# Anthropic フォールバック（claude-sonnet エイリアス用）
# https://console.anthropic.com/ でキー取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── cocoro-core 連携 ──────────────────────────────────────────────────────────
COCORO_API_KEY=cocoro-2026
COCORO_CORE_URL=http://192.168.50.92:8001
COCORO_AGENT_URL=http://192.168.50.86:8002

# ── モニタリング ──────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme_please

# Prometheus基本認証（任意）
# PROMETHEUS_USERNAME=admin
# PROMETHEUS_PASSWORD=changeme_please

# ── ネットワーク ──────────────────────────────────────────────────────────────
LLM_SERVER_IP=192.168.50.112

# ── ログ ─────────────────────────────────────────────────────────────────────
LOG_DIR=/var/log/cocoro-llm
LOG_LEVEL=INFO
