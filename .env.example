# =============================================================================
# .env.example — cocoro-llm-server
# このファイルを .env にコピーして実際の値を設定してください。
# 通常は scripts/first_setup.sh が対話式で .env を自動生成します。
#
#   cp .env.example .env
#   vim .env
# =============================================================================

# ──────────────────────────────────────────────────────────────
# HuggingFace（モデルダウンロード用）
# モデルが既にローカルにある場合は空のままでOK
# 取得: https://huggingface.co/settings/tokens
# ──────────────────────────────────────────────────────────────
HF_TOKEN=
HF_CACHE_DIR=/hf_cache    # 高速SSD/NVMeを推奨（モデル70GB+）

# ──────────────────────────────────────────────────────────────
# Primary vLLM サービス設定（Qwen3-Coder-Next-FP8）
# ──────────────────────────────────────────────────────────────
PRIMARY_MODEL_PATH=Qwen/Qwen3-Coder-Next-FP8
PRIMARY_GPU_UTIL=0.92          # ~87GB (weights 70GB + KV 17GB fp8)
PRIMARY_MAX_MODEL_LEN=262144   # 256K tokens
PRIMARY_MAX_NUM_SEQS=32        # 並列リクエスト上限

# ──────────────────────────────────────────────────────────────
# LiteLLM ゲートウェイ
# クライアントが接続する API キー。必ず変更してください。
# scripts/first_setup.sh を使うと自動生成されます。
# ──────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=

# ──────────────────────────────────────────────────────────────
# Anthropic（Claude フォールバック用・任意）
# 設定すると smart-coder ルートでローカルが失敗した時に Claude へ自動切替
# 取得: https://console.anthropic.com/settings/keys
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
