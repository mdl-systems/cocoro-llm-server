[Unit]
Description=vLLM Primary — Qwen 2.5 72B Instruct AWQ (port 8080)
Documentation=https://github.com/mdl-systems/cocoro-llm-server
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
User=mdl
Group=mdl

# ---- 環境変数 ----
Environment="CUDA_HOME=/usr/local/cuda"
Environment="TORCH_CUDA_ARCH_LIST=12.0"
Environment="FLASHINFER_CUDA_ARCH_LIST=12.0"
Environment="VLLM_ATTENTION_BACKEND=FLASHINFER"
Environment="VLLM_WORKER_MULTIPROC_METHOD=spawn"
Environment="VLLM_USE_V1=1"
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"

# PATH に CUDA と vLLM 仮想環境を含める
Environment="PATH=/home/mdl/.venv/cocoro-llm/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ---- 実行 ----
WorkingDirectory=/home/mdl/cocoro-llm-server
ExecStart=/bin/bash /home/mdl/cocoro-llm-server/vllm/start_primary.sh

# ---- ログ ----
# stdout/stderr は start_primary.sh 内で /var/log/cocoro-llm/vllm-primary.log に書き出し
# systemd journal にも並行して記録
StandardOutput=append:/var/log/cocoro-llm/vllm-primary.log
StandardError=append:/var/log/cocoro-llm/vllm-primary.log

# ---- リスタートポリシー ----
# OOM・モデルロードエラー含む異常終了時にリスタート
# 3分以内に 5回失敗した場合は諦める（無限ループ防止）
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=180
StartLimitBurst=5

# ---- タイムアウト ----
# Qwen 2.5 72B AWQ のモデルロードは最大 15分程度
TimeoutStartSec=900
TimeoutStopSec=60

# ---- リソース制限 ----
# LimitNOFILE を引き上げ（vLLM は多くのファイルディスクリプタを使用）
LimitNOFILE=1048576
# GPU メモリ管理のため OOM スコアを下げる
OOMScoreAdjust=-500

# ---- セキュリティ ----
# GPU アクセスのため制限は緩め
NoNewPrivileges=false
ProtectHome=false
ProtectSystem=false

[Install]
WantedBy=multi-user.target
