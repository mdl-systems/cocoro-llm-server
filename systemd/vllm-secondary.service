# =============================================================================
# vllm-secondary.service — 廃止済み (DEPRECATED)
# =============================================================================
# 2026-04-14: Qwen 2.5 72B AWQ 単体構成への移行に伴い廃止。
# Qwen 2.5 32B AWQ (Secondary) は削除済み。
#
# このファイルはサーバーに /etc/systemd/system/ にインストールしないこと。
# 参照のみ保持。
# =============================================================================

[Unit]
Description=vLLM Secondary — DEPRECATED (単体構成のため使用しない)
Documentation=https://github.com/mdl-systems/cocoro-llm-server
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/echo "vllm-secondary は廃止されました。Qwen 2.5 72B AWQ 単体構成を使用してください。"
RemainAfterExit=no

[Install]
# WantedBy を空にすることで自動インストールを無効化
