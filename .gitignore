# =============================================================================
# .gitignore — cocoro-llm-server
# モデルウェイト・シークレット・ビルド成果物を除外
# =============================================================================

# ── 絶対にコミットしないもの ──────────────────────────────────────────────────
.env
*.key
*.pem
*.p12
secrets/

# ── LiteLLM ランタイム生成物（config.yaml.tmpl から sed 展開される）──────────
litellm/config.yaml

# ── アーカイブ（旧ファイル・個人情報・APIキー含む）──────────────────────────
_archive/

# ── Claude Code 個人設定（PCごとの設定なのでコミットしない）─────────────────
.claude/settings.local.json
.claude/worktrees/

# ── モデルウェイト（4TB NVMeに格納、gitで管理しない）────────────────────────
/models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
model.safetensors*
pytorch_model*.bin*
tokenizer.model
*.ot

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
# vLLM仮想環境はホスト/optに配置するため除外不要だがローカルvenvも念のため
.env/

# ── vLLM ビルドキャッシュ ─────────────────────────────────────────────────────
/opt/vllm-build/
*.cu.o
*.ptx

# ── Docker ───────────────────────────────────────────────────────────────────
docker/.env

# ── ログ ─────────────────────────────────────────────────────────────────────
*.log
/var/log/
logs/

# ── opencode CLI ──────────────────────────────────────────────────────────────
opencode.json

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# ── テスト成果物 ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── Grafana プロビジョニングデータ ────────────────────────────────────────────
monitoring/grafana/data/

# ── Prometheus データ ─────────────────────────────────────────────────────────
monitoring/prometheus/data/

# ── サーバー側ローカルファイル（シンボリックリンク等）────────────────────────
cocoro-llm-server
.env.save
fp8_download.log
fp8_download.pid
qwen_download.log
qwen_download.pid

# ── HuggingFace キャッシュ（モデルウェイト、巨大ファイル）─────────────────────
hf_cache/
.cache/huggingface/
