# =============================================================================
# litellm/config.yaml.tmpl — LiteLLM 設定テンプレート
#
# このファイルは litellm/entrypoint.sh により ${SERVED_MODEL_NAME} を実値展開して
# config.yaml にレンダリングされてから LiteLLM に読み込まれます。
#
# ローカルモデル名は docker-compose.yml の anchor `&served_model_name` で一元管理
# されており（デフォルト: coco-local）、ここでは ${SERVED_MODEL_NAME} を参照する
# だけで済みます。
# =============================================================================

model_list:
  # ──────────────────────────────────────────────────────────
  # Route 1: ローカル vLLM 直接ルート（普段使い・名前は SERVED_MODEL_NAME）
  # ──────────────────────────────────────────────────────────
  - model_name: ${SERVED_MODEL_NAME}
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 32768
      timeout: 300
      stream_timeout: 300

  # ──────────────────────────────────────────────────────────
  # interactive — 人間が直接対話するルート（高優先度）
  # worker      — サブエージェント・ファンアウト用ルート（低優先度）
  #
  # 今は両方とも同じ vLLM(vllm-primary) を指す = 単一モデル高並列（これが本来の目的）。
  # もし将来モデルを足したくなった場合の保険として、worker の api_base を
  # 新エンドポイントへ差し替えるだけで物理二層化できる（再設計不要）。追加は未確定。
  # priority: vLLM の --scheduling-policy priority と連動。小さいほど優先。
  # ──────────────────────────────────────────────────────────
  - model_name: interactive
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 32768
      timeout: 300
      stream_timeout: 300
      extra_body:
        priority: 0

  - model_name: worker
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 32768
      timeout: 300
      stream_timeout: 300
      extra_body:
        priority: 100

  # ──────────────────────────────────────────────────────────
  # Route 2: claude-sonnet — クラウド直接（難タスク手動指定）
  # ──────────────────────────────────────────────────────────
  - model_name: claude-sonnet
    litellm_params:
      model: claude-sonnet-4-5
      api_key: "os.environ/ANTHROPIC_API_KEY"
      max_tokens: 16000
      timeout: 120

  # ──────────────────────────────────────────────────────────
  # Route 3: smart-coder — ローカル優先・失敗時Claudeフォールバック
  # （信頼性重視ワークフロー用 / 推奨デフォルト）
  # ──────────────────────────────────────────────────────────
  - model_name: smart-coder
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 32768
      timeout: 300
      stream_timeout: 300
    fallbacks:
      - claude-sonnet

  # ──────────────────────────────────────────────────────────
  # Claude Code対応エイリアス（ANTHROPIC_BASE_URL経由でローカルvLLMへ）
  # Claude Codeが送るモデル名をそのまま受け取ってvLLMに流す
  # ──────────────────────────────────────────────────────────
  - model_name: claude-sonnet-4-6
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 32768
      timeout: 300
      stream_timeout: 300

  - model_name: claude-opus-4-7
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 32768
      timeout: 300
      stream_timeout: 300

  - model_name: claude-haiku-4-5-20251001
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 16384
      timeout: 180
      stream_timeout: 180

  # ──────────────────────────────────────────────────────────
  # OpenAI互換エイリアス（後方互換）
  # ──────────────────────────────────────────────────────────
  - model_name: gpt-4o
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 32768
      timeout: 300

  - model_name: gpt-4o-mini
    litellm_params:
      model: openai/${SERVED_MODEL_NAME}
      api_base: "http://vllm-primary:8000/v1"
      api_key: "dummy"
      max_tokens: 16384
      timeout: 180

router_settings:
  routing_strategy: simple-shuffle
  # エージェント用途: 重い長時間リクエストがタイムアウトすると
  # リトライ=同じ高コスト処理の二重実行になり自滅する。1回に絞る。
  num_retries: 1
  retry_after: 5

general_settings:
  master_key: "os.environ/LITELLM_MASTER_KEY"
  database_url: null
  allow_requests_on_db_unavailable: true
  request_timeout: 300

litellm_settings:
  log_level: "INFO"
  success_callback: []
  failure_callback: []
  callbacks: []
  cache: false
  drop_params: true
  num_retries: 1   # 上記と同理由: 長時間タスクの二重実行を避ける
  request_timeout: 300

environment_variables:
  LITELLM_MASTER_KEY: "os.environ/LITELLM_MASTER_KEY"
  ANTHROPIC_API_KEY: "os.environ/ANTHROPIC_API_KEY"
